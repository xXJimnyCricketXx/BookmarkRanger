{
  "name": "bookmarkranger",
  "version": "1.2.0",
  "description": "Self-hosted bookmarks and code snippet manager",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "node --test --test-concurrency=2 \"test/*.test.js\"",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:seed": "node prisma/seed.js",
    "build:css": "tailwindcss -c tailwind.config.js -i assets/tailwind.css -o public/vendor/tailwind.min.css --minify"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.5.0",
    "ejs": "^7.0.2",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "highlight.js": "^11.12.0",
    "i18next": "^25.8.0",
    "i18next-fs-backend": "^2.6.0",
    "i18next-http-middleware": "^3.9.2",
    "session-file-store": "^1.5.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "prisma": "^7.10.1",
    "tailwindcss": "^3.4.19"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true
  }
}
