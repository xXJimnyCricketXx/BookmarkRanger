generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  language     String   @default("de")
  createdAt    DateTime @default(now())
}

model Settings {
  id                     Int     @id @default(autoincrement())
  siteName               String  @default("BookmarkRanger")
  themePreset            String  @default("bookmarkranger")
  sortingType            String  @default("createdAt")
  pinBookmarksByDefault  Boolean @default(false)
  pinSnippetsByDefault   Boolean @default(false)
  pinCategoriesByDefault Boolean @default(false)
  openLinksInNewTab      Boolean @default(true)
  hideSearchBar          Boolean @default(false)
  hideBookmarksSection   Boolean @default(false)
  hideSnippetsSection    Boolean @default(false)
  hideHeadline           Boolean @default(false)
  hideDate               Boolean @default(false)
  hideTime               Boolean @default(true)
  hideWeather            Boolean @default(false)
  weatherLocation        String?
  weatherLat             Float?
  weatherLon             Float?
  dateFormat             String  @default("day-first")
  customGreetings        String  @default("Guten Abend!;Guten Tag!;Guten Morgen!;Gute Nacht!")
  customWeekdayNames     String  @default("Sonntag;Montag;Dienstag;Mittwoch;Donnerstag;Freitag;Samstag")
  customMonthNames       String  @default("Januar;Februar;März;April;Mai;Juni;Juli;August;September;Oktober;November;Dezember")
  fallbackSearchProvider   SearchProvider? @relation(fields: [fallbackSearchProviderId], references: [id])
  fallbackSearchProviderId Int?
}

model SearchProvider {
  id            Int        @id @default(autoincrement())
  name          String
  queryTemplate String
  settings      Settings[]
}

model CustomTheme {
  id        Int      @id @default(autoincrement())
  name      String
  bg        String
  text      String
  accent    String
  header    String
  createdAt DateTime @default(now())
}

model Board {
  id         Int        @id @default(autoincrement())
  name       String
  order      Int        @default(0)
  createdAt  DateTime   @default(now())
  categories Category[]
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String
  icon      String?
  color     String?
  order     Int        @default(0)
  isPinned  Boolean    @default(false)
  board     Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId   Int
  bookmarks Bookmark[]
}

model Bookmark {
  id            Int       @id @default(autoincrement())
  title         String
  url           String
  description   String?
  icon          String?
  order         Int       @default(0)
  clicks        Int       @default(0)
  lastVisitedAt DateTime?
  isPinned      Boolean   @default(false)
  category      Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId    Int
  tags          Tag[]     @relation("BookmarkTags")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // Dashboard-only grouping (see DashboardGroup) — separate from category/board
  // organization, and from `order` which is the position within its category.
  dashboardGroup      DashboardGroup? @relation(fields: [dashboardGroupId], references: [id])
  dashboardGroupId    Int?
  dashboardGroupOrder Int             @default(0)
}

// A dashboard-only "box" a user creates by dragging one pinned bookmark onto another,
// grouping several pinned bookmarks together (like a Kanban column) without touching
// their actual Board/Category on the Bookmarks page.
model DashboardGroup {
  id        Int        @id @default(autoincrement())
  name      String
  order     Int        @default(0)
  bookmarks Bookmark[]
}

model Snippet {
  id               Int      @id @default(autoincrement())
  title            String
  shortDescription String?
  language         String
  code             String
  documentation    String?
  order            Int      @default(0)
  isPinned         Boolean  @default(false)
  tags             Tag[]    @relation("SnippetTags")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Tag {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  bookmarks Bookmark[] @relation("BookmarkTags")
  snippets  Snippet[]  @relation("SnippetTags")
}
