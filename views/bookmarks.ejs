<% locals.activeNav = 'bookmarks'; %>
<%- include('partials/header') %>

<% if (boards.length > 0 || activeBoard) { %>
<div class="flex items-center justify-end gap-4 mb-3 text-xs">
  <% if (activeBoard) { %>
    <button type="button" id="new-category-btn" class="opacity-60 hover:opacity-100 flex items-center gap-1"><i class="fa-solid fa-plus"></i> <%= t('bookmarks.add_category') %></button>
  <% } %>
  <% if (boards.length > 0) { %>
    <button type="button" id="edit-boards-btn" class="opacity-60 hover:opacity-100 flex items-center gap-1"><i class="fa-solid fa-pen"></i> <%= t('bookmarks.edit_boards') %></button>
  <% } %>
</div>
<% } %>

<div class="flex items-center gap-1 overflow-x-auto border-b border-black/10 dark:border-white/10 mb-3">
  <% boards.forEach(board => { %>
    <a href="<%= baseUrl %>/bookmarks?board=<%= board.id %>" data-board-id="<%= board.id %>" class="tab-link px-4 py-3 text-sm font-bold whitespace-nowrap <%= activeBoard && activeBoard.id === board.id ? 'active' : '' %>"><%= board.name %></a>
  <% }) %>
  <button type="button" id="new-board-btn" class="tab-link px-4 py-3 text-lg font-bold">+</button>
</div>

<form id="new-board-form" action="<%= baseUrl %>/bookmarks/boards" method="POST" class="hidden mb-8 flex gap-2 max-w-sm">
  <input type="text" name="name" required placeholder="<%= t('bookmarks.add_board') %>" class="input-theme flex-grow px-3 py-2 rounded-lg text-sm" autofocus>
  <button type="submit" class="bg-primary-theme px-4 py-2 rounded-lg text-sm font-bold">OK</button>
</form>

<div id="board-panel">
  <%- include('partials/board-panel', { activeBoard, categories }) %>
</div>

<div id="manage-boards-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div id="manage-boards-backdrop" class="absolute inset-0 bg-black/60"></div>
  <div class="card-theme relative rounded-3xl shadow-xl p-6 w-full max-w-md">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-lg font-black"><%= t('bookmarks.manage_boards') %></h2>
      <button type="button" id="manage-boards-close" class="w-8 h-8 rounded-full flex items-center justify-center hover:bg-black/10 dark:hover:bg-white/10 transition">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
    <div class="space-y-2">
      <% boards.forEach(board => { %>
        <div class="flex items-center gap-2">
          <form action="<%= baseUrl %>/bookmarks/boards/<%= board.id %>/rename" method="POST" class="flex-grow min-w-0">
            <input type="text" name="name" value="<%= board.name %>" onchange="this.form.submit()" class="input-theme w-full px-3 py-2 rounded-lg text-sm">
          </form>
          <form action="<%= baseUrl %>/bookmarks/boards/<%= board.id %>/delete" method="POST" onsubmit="return confirm('<%= t('common.confirm_delete', { name: board.name }) %>')">
            <button type="submit" title="<%= t('bookmarks.delete') %>" class="w-9 h-9 shrink-0 rounded-lg flex items-center justify-center hover:bg-red-500/10 text-red-500"><i class="fa-solid fa-trash text-xs"></i></button>
          </form>
        </div>
      <% }) %>
    </div>

    <% if (activeBoard) { %>
    <h3 class="text-sm font-black opacity-60 uppercase tracking-wide mt-6 mb-3"><%= t('bookmarks.manage_categories') %></h3>
    <div id="manage-categories-list" class="space-y-2">
      <% categories.forEach(category => { %>
        <div class="flex items-center gap-2">
          <form action="<%= baseUrl %>/bookmarks/categories/<%= category.id %>/rename" method="POST" class="flex-grow min-w-0">
            <input type="text" name="name" value="<%= category.name %>" onchange="this.form.submit()" class="input-theme w-full px-3 py-2 rounded-lg text-sm">
          </form>
          <form action="<%= baseUrl %>/bookmarks/categories/<%= category.id %>/delete" method="POST" onsubmit="return confirm('<%= t('common.confirm_delete', { name: category.name }) %>')">
            <button type="submit" title="<%= t('bookmarks.delete') %>" class="w-9 h-9 shrink-0 rounded-lg flex items-center justify-center hover:bg-red-500/10 text-red-500"><i class="fa-solid fa-trash text-xs"></i></button>
          </form>
        </div>
      <% }) %>
    </div>
    <% } %>
  </div>
</div>

<script>
  document.getElementById('new-board-btn').addEventListener('click', () => {
    document.getElementById('new-board-form').classList.toggle('hidden');
  });

  const boardPanel = document.getElementById('board-panel');

  const newCategoryBtn = document.getElementById('new-category-btn');
  if (newCategoryBtn) {
    // The form lives inside #board-panel, which gets replaced on every board switch —
    // look it up fresh on each click instead of caching a reference that'd go stale.
    newCategoryBtn.addEventListener('click', () => {
      boardPanel.querySelector('.new-category-form').classList.toggle('hidden');
    });
  }

  const manageBoardsModal = document.getElementById('manage-boards-modal');
  const editBoardsBtn = document.getElementById('edit-boards-btn');
  if (editBoardsBtn) editBoardsBtn.addEventListener('click', () => manageBoardsModal.classList.remove('hidden'));
  document.getElementById('manage-boards-close').addEventListener('click', () => manageBoardsModal.classList.add('hidden'));
  document.getElementById('manage-boards-backdrop').addEventListener('click', () => manageBoardsModal.classList.add('hidden'));

  function renderCategoryRows(categories) {
    const list = document.getElementById('manage-categories-list');
    if (!list) return;
    list.innerHTML = categories.map((category) => `
      <div class="flex items-center gap-2">
        <form action="<%= baseUrl %>/bookmarks/categories/${category.id}/rename" method="POST" class="flex-grow min-w-0">
          <input type="text" name="name" value="${category.name}" onchange="this.form.submit()" class="input-theme w-full px-3 py-2 rounded-lg text-sm">
        </form>
        <form action="<%= baseUrl %>/bookmarks/categories/${category.id}/delete" method="POST">
          <button type="submit" title="<%= t('bookmarks.delete') %>" class="w-9 h-9 shrink-0 rounded-lg flex items-center justify-center hover:bg-red-500/10 text-red-500"><i class="fa-solid fa-trash text-xs"></i></button>
        </form>
      </div>
    `).join('');
    // Delegated once on the container itself since these rows get rebuilt on every switch.
    list.querySelectorAll('form[action*="/delete"]').forEach((form) => {
      form.addEventListener('submit', (e) => {
        const name = form.querySelector('input')?.value;
        if (!confirm('<%= t("common.confirm_delete", { name: "__NAME__" }) %>'.replace('__NAME__', name))) e.preventDefault();
      });
    });
  }

  async function loadBoard(boardId, push) {
    try {
      const res = await fetch('<%= baseUrl %>/bookmarks/boards/' + boardId + '/panel');
      if (!res.ok) throw new Error('bad response');
      const data = await res.json();
      boardPanel.innerHTML = data.html;
      window.initDragroots(boardPanel);
      renderCategoryRows(data.categories);

      document.querySelectorAll('.tab-link[data-board-id]').forEach((tab) => {
        tab.classList.toggle('active', tab.dataset.boardId === String(boardId));
      });

      if (push) history.pushState({ boardId }, '', '<%= baseUrl %>/bookmarks?board=' + boardId);
    } catch (err) {
      // Fragment fetch failed (offline, server error, …) — fall back to a real navigation
      // instead of leaving the click looking like it did nothing.
      window.location.href = '<%= baseUrl %>/bookmarks?board=' + boardId;
    }
  }

  document.querySelectorAll('.tab-link[data-board-id]').forEach((tab) => {
    tab.addEventListener('click', (e) => {
      e.preventDefault();
      loadBoard(tab.dataset.boardId, true);
    });
  });

  window.addEventListener('popstate', () => {
    const params = new URLSearchParams(window.location.search);
    const boardId = params.get('board');
    if (boardId) loadBoard(boardId, false);
  });
</script>

<%- include('partials/footer') %>
