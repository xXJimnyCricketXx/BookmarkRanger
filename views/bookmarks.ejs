<% locals.activeNav = 'bookmarks'; %>
<%- include('partials/header') %>

<div class="flex items-center gap-1 overflow-x-auto border-b border-black/10 dark:border-white/10 mb-3">
  <% boards.forEach(board => { %>
    <a href="<%= baseUrl %>/bookmarks?board=<%= board.id %>" data-board-id="<%= board.id %>" class="tab-link px-4 py-3 text-sm font-bold whitespace-nowrap <%= activeBoard && activeBoard.id === board.id ? 'active' : '' %>"><%= board.name %></a>
  <% }) %>
  <button type="button" id="new-board-btn" class="tab-link px-4 py-3 text-lg font-bold">+</button>
</div>

<form id="new-board-form" action="<%= baseUrl %>/bookmarks/boards" method="POST" class="hidden mb-8 flex gap-2 max-w-sm">
  <input type="text" name="name" required placeholder="<%= t('bookmarks.add_board') %>" class="input-theme flex-grow px-3 py-2 rounded-lg text-sm" autofocus>
  <button type="submit" class="bg-primary-theme px-4 py-2 rounded-lg text-sm font-bold">OK</button>
</form>

<div id="board-panel">
  <%- include('partials/board-panel', { activeBoard, categories }) %>
</div>

<script>
  document.getElementById('new-board-btn').addEventListener('click', () => {
    document.getElementById('new-board-form').classList.toggle('hidden');
  });

  const boardPanel = document.getElementById('board-panel');

  // Event delegation: buttons/forms inside #board-panel get replaced on every board
  // switch, so listeners bound directly to them would go stale — bind on the stable
  // parent instead.
  boardPanel.addEventListener('click', (e) => {
    if (e.target.closest('.rename-board-btn')) {
      boardPanel.querySelector('.rename-board-form').classList.toggle('hidden');
    }
    if (e.target.closest('.new-category-btn')) {
      boardPanel.querySelector('.new-category-form').classList.toggle('hidden');
    }
  });
  boardPanel.addEventListener('submit', (e) => {
    const form = e.target;
    if (form.classList.contains('delete-board-form') && !confirm(form.dataset.confirm)) {
      e.preventDefault();
    }
  });

  async function loadBoard(boardId, push) {
    try {
      const res = await fetch('<%= baseUrl %>/bookmarks/boards/' + boardId + '/panel');
      if (!res.ok) throw new Error('bad response');
      const data = await res.json();
      boardPanel.innerHTML = data.html;

      document.querySelectorAll('.tab-link[data-board-id]').forEach((tab) => {
        tab.classList.toggle('active', tab.dataset.boardId === String(boardId));
      });

      if (push) history.pushState({ boardId }, '', '<%= baseUrl %>/bookmarks?board=' + boardId);
    } catch (err) {
      // Fragment fetch failed (offline, server error, …) — fall back to a real navigation
      // instead of leaving the click looking like it did nothing.
      window.location.href = '<%= baseUrl %>/bookmarks?board=' + boardId;
    }
  }

  document.querySelectorAll('.tab-link[data-board-id]').forEach((tab) => {
    tab.addEventListener('click', (e) => {
      e.preventDefault();
      loadBoard(tab.dataset.boardId, true);
    });
  });

  window.addEventListener('popstate', () => {
    const params = new URLSearchParams(window.location.search);
    const boardId = params.get('board');
    if (boardId) loadBoard(boardId, false);
  });
</script>

<%- include('partials/footer') %>
