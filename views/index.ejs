<% locals.activeNav = 'home'; %>
<% const canDrag = settings.sortingType === 'custom'; %>
<%- include('partials/header') %>

<% const showDateTime = !settings.hideDate || !settings.hideTime; %>
<% const showWeather = !settings.hideWeather && weather; %>
<% if (showDateTime || showWeather) { %>
<div class="flex items-center justify-between text-xs opacity-60 mb-8">
  <div class="space-x-2">
    <% if (!settings.hideDate) { %><span><%= formattedDate %></span><% } %>
    <% if (!settings.hideTime) { %><span id="dashboard-clock"></span><% } %>
  </div>
  <div>
    <% if (showWeather) { %>
    <div class="flex items-center gap-2">
      <i class="fa-solid <%= weather.icon %> text-xl text-primary-theme"></i>
      <div class="leading-tight">
        <div class="font-bold"><%= weather.temp %><%= weather.unit %></div>
        <div class="border-t border-black/10 dark:border-white/10 pt-0.5 mt-0.5"><%= weather.extra %>%</div>
      </div>
    </div>
    <% } %>
  </div>
</div>
<% } %>
<% if (!settings.hideTime) { %>
<script>
  (function () {
    const el = document.getElementById('dashboard-clock');
    function tick() {
      el.textContent = new Date().toLocaleTimeString('<%= currentLng %>', { hour: '2-digit', minute: '2-digit' });
    }
    tick();
    setInterval(tick, 1000 * 30);
  })();
</script>
<% } %>

<% if (!settings.hideHeadline || !settings.hideSearchBar) { %>
<section class="card-theme rounded-3xl p-6 md:p-12 shadow-2xl mb-20 text-center space-y-12 md:space-y-16">
  <% if (!settings.hideHeadline) { %>
    <h1 class="text-3xl md:text-6xl font-black tracking-tight"><%- greeting %></h1>
  <% } %>

  <% if (!settings.hideSearchBar) { %>
  <form action="<%= baseUrl %>/" method="GET" id="search-form">
    <div class="flex items-stretch gap-2 max-w-2xl mx-auto">
      <div class="input-theme flex-grow flex items-stretch rounded-2xl shadow-lg overflow-hidden">
        <div class="relative flex-grow">
          <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 opacity-40"></i>
          <input type="text" name="q" value="<%= q %>" id="search-input"
            class="w-full h-full bg-transparent border-0 pl-11 pr-4 py-3 text-sm focus:outline-none focus:ring-0"
            placeholder="<%= t('dashboard.search_placeholder') %>" <%= settings.disableSearchAutofocus ? '' : 'autofocus' %>>
        </div>
        <div class="relative group shrink-0 max-w-[8.5rem] border-l border-black/10 dark:border-white/10">
          <select id="search-provider-select"
            class="appearance-none bg-transparent border-0 text-sm pl-3 pr-6 py-3 w-full focus:outline-none focus:ring-0 cursor-pointer">
            <option value="local"><%= t('dashboard.local_search') %></option>
            <% searchProviders.forEach(provider => { %>
              <option value="<%= provider.id %>" data-template="<%= provider.queryTemplate %>"><%= provider.name %></option>
            <% }) %>
          </select>
          <i class="fa-solid fa-chevron-down text-[9px] opacity-20 group-hover:opacity-60 transition-all absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none"></i>
        </div>
        <button type="submit" class="bg-primary-theme px-5 text-sm font-bold hover:brightness-110 transition shrink-0"><%= t('dashboard.search_button') %></button>
      </div>
    </div>
  </form>
  <% } %>
</section>
<% } %>

<% if (!settings.hideSearchBar) { %>
<script>
  document.getElementById('search-input').addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { e.target.value = ''; e.target.form.submit(); }
  });
  document.getElementById('search-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const query = document.getElementById('search-input').value;
    if (!query) return;

    const select = document.getElementById('search-provider-select');
    const option = select.options[select.selectedIndex];
    const template = option.dataset.template;

    if (template) {
      // A specific provider was picked: open it directly, still inside this click's
      // user-activation window, so the browser never treats it as an unrelated popup.
      window.open(template + encodeURIComponent(query), '_blank');
      return;
    }

    // "Lokale Suche": ask the server first via fetch (no page reload yet) so that if
    // nothing is found, window.open() below still runs on *this* document — a reload
    // first would drop the browser's user-activation state and get the tab blocked.
    fetch('<%= baseUrl %>/api/search-check?q=' + encodeURIComponent(query))
      .then((r) => r.json())
      .then((data) => {
        if (data.fallbackHref) window.open(data.fallbackHref, '_blank');
        window.location.href = '<%= baseUrl %>/?q=' + encodeURIComponent(query);
      })
      .catch(() => {
        window.location.href = '<%= baseUrl %>/?q=' + encodeURIComponent(query);
      });
  });
</script>
<% } %>

<% if (isSearch) { %>
<h2 class="text-lg font-black mb-6 opacity-80"><%= t('dashboard.search_results_for') %> "<%= q %>"</h2>
<% } %>

<% if (noResults) { %>
<div class="card-theme rounded-3xl p-6 mb-10">
  <p class="text-sm opacity-70">
    <%= t('dashboard.no_local_results') %>
    <% if (fallbackSearchHref) { %> <%= t('dashboard.opening_externally') %><% } %>
  </p>
</div>
<% } %>

<% if (!noResults && !settings.hideBookmarksSection) { %>
<section class="mb-32 md:mb-60">
  <h2 class="text-xl font-black mb-3"><%= t('dashboard.pinned_bookmarks') %></h2>
  <div class="border-b border-black/10 dark:border-white/10 mb-8"></div>
  <% if (pinnedCategories.length === 0 && pinnedBookmarks.length === 0 && dashboardGroups.length === 0) { %>
    <p class="opacity-50 text-sm"><%= t('dashboard.no_pinned_bookmarks') %></p>
  <% } else { %>
    <div id="pinned-bookmarks-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-3 items-start <%= canDrag ? 'bm-dragroot' : '' %>" <%- canDrag ? `data-reorder-url="${baseUrl}/bookmarks/reorder"` : "" %>>
      <% pinnedCategories.forEach(category => { %>
        <%- include('partials/dashboard-category-box', { category, draggable: canDrag }) %>
      <% }) %>
      <% dashboardGroups.forEach(group => { %>
        <%- include('partials/dashboard-group-box', { group, draggable: canDrag }) %>
      <% }) %>
      <% pinnedBookmarks.forEach(bookmark => { %>
        <%- include('partials/bookmark-pin-card', { bookmark, draggable: canDrag }) %>
      <% }) %>
    </div>
  <% } %>
</section>
<% } %>

<% if (!noResults && !settings.hideSnippetsSection) { %>
<section class="mb-20">
  <h2 class="text-xl font-black mb-3"><%= t('dashboard.pinned_snippets') %></h2>
  <div class="border-b border-black/10 dark:border-white/10 mb-8"></div>
  <% if (pinnedSnippets.length === 0) { %>
    <p class="opacity-50 text-sm"><%= t('dashboard.no_pinned_snippets') %></p>
  <% } else { %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 <%= canDrag ? 'dragroot' : '' %>" <%- canDrag ? `data-reorder-url="${baseUrl}/snippets/reorder"` : "" %>>
      <% pinnedSnippets.forEach(snippet => { %>
        <%- include('partials/snippet-card', { snippet, draggable: canDrag }) %>
      <% }) %>
    </div>
  <% } %>
  <% if (!isSearch && !canDrag && (pinnedBookmarks.length > 0 || pinnedSnippets.length > 0)) { %>
    <p class="text-xs opacity-40 mt-4"><%= t('dashboard.drag_hint') %></p>
  <% } %>
</section>
<% } %>

<%- include('partials/footer') %>
