<div class="<%= locals.draggable ? 'draggable-item' : '' %>" <%- locals.draggable ? `data-id="group-${group.id}"` : "" %>>
  <div class="flex items-center mb-3 gap-2 pb-1 border-b border-current">
    <% if (locals.draggable) { %>
      <i class="fa-solid fa-grip-vertical drag-handle text-xs opacity-30 hover:opacity-70 cursor-grab active:cursor-grabbing shrink-0" title="<%= t('dashboard.drag_handle') %>"></i>
    <% } %>
    <form action="<%= baseUrl %>/dashboard-groups/<%= group.id %>/rename" method="POST" class="flex-grow min-w-0">
      <input type="text" name="name" value="<%= group.name %>" onchange="this.form.submit()"
        class="bg-transparent border-0 font-black text-primary-theme uppercase text-xs tracking-wide w-full focus:outline-none p-0">
    </form>
    <form action="<%= baseUrl %>/dashboard-groups/<%= group.id %>/delete" method="POST" data-confirm="<%= t('common.confirm_dissolve_group', { name: group.name }) %>">
      <button type="submit" title="<%= t('dashboard.dissolve_group') %>" class="shrink-0"><i class="fa-solid fa-trash text-xs opacity-30 hover:opacity-70"></i></button>
    </form>
  </div>

  <div class="group-members space-y-1 <%= locals.draggable ? 'bm-group-members' : '' %>" data-group-id="<%= group.id %>">
    <% group.bookmarks.forEach(bookmark => { %>
      <div class="group flex items-center gap-2 py-1 <%= locals.draggable ? 'draggable-item' : '' %>" <%- locals.draggable ? `data-id="${bookmark.id}"` : "" %>>
        <% if (locals.draggable) { %>
          <i class="fa-solid fa-grip-vertical drag-handle text-xs opacity-30 hover:opacity-70 cursor-grab active:cursor-grabbing shrink-0" title="<%= t('dashboard.drag_handle') %>"></i>
        <% } %>
        <a href="<%= bookmark.url %>" <%- settings.openLinksInNewTab ? 'target="_blank" rel="noopener"' : '' %> class="flex items-center gap-2 text-sm hover:text-primary-theme transition-colors truncate min-w-0 flex-grow">
          <%- include('bookmark-icon', { icon: bookmark.icon, size: 'w-4 h-4 rounded-sm' }) %>
          <span class="truncate"><%= bookmark.title %></span>
        </a>
        <form action="<%= baseUrl %>/dashboard-groups/bookmarks/<%= bookmark.id %>/remove" method="POST" class="hidden group-hover:block shrink-0">
          <button type="submit" title="<%= t('dashboard.remove_from_group') %>"><i class="fa-solid fa-xmark text-xs opacity-40 hover:opacity-80"></i></button>
        </form>
      </div>
    <% }) %>
  </div>
</div>
