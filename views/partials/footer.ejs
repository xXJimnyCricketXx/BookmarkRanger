  </main>

  <footer class="mt-auto footer-custom transition-colors duration-300">
    <div class="max-w-screen-xl mx-auto py-5 px-4 text-center text-xs">
      <span class="opacity-60"><%= t('footer.powered_by_prefix') %></span>
      <a href="https://cricketcode.de" target="_blank" rel="noopener" class="text-primary-theme hover:underline">CricketCode Web Solutions</a>
    </div>
  </footer>

  <script>
    document.addEventListener('click', async (e) => {
      const btn = e.target.closest('.copy-code-btn');
      if (!btn) return;
      const id = btn.dataset.copy;
      const source = document.getElementById('code-' + id);
      if (!source) return;
      try {
        await navigator.clipboard.writeText(source.value);
        const original = btn.textContent;
        btn.textContent = '<%= t("snippets.copied") %>';
        setTimeout(() => { btn.textContent = original; }, 1500);
      } catch (err) { /* clipboard unavailable */ }
    });
  </script>

  <script>
    // SortableJS handles the dashed drop-placeholder and clean reordering (including
    // between rows) that the hand-rolled HTML5 drag-and-drop version couldn't do reliably.
    document.querySelectorAll('.dragroot').forEach((root) => {
      Sortable.create(root, {
        animation: 150,
        ghostClass: 'sortable-ghost',
        chosenClass: 'sortable-chosen',
        dragClass: 'sortable-drag',
        onEnd: () => {
          const ids = [...root.querySelectorAll('.draggable-item')].map((el) => el.dataset.id);
          fetch(root.dataset.reorderUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ids })
          }).catch(() => {});
        }
      });
    });
  </script>

  <script>
    // Pinned bookmarks + dashboard groups share one Sortable "group" so cards can move
    // between the standalone grid and any box's member list. Dropping card A onto the
    // middle of standalone card B (not onto a box) creates a brand new box holding both.
    (function () {
      const mainGrid = document.getElementById('pinned-bookmarks-grid');
      const bmLists = document.querySelectorAll('.bm-dragroot, .bm-group-members');
      if (!bmLists.length) return;

      function directItems(root) {
        return [...root.children].filter((el) => el.classList.contains('draggable-item'));
      }

      function persist(url, body) {
        return fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        }).catch(() => {});
      }

      let mergeCandidate = null;
      function clearMergeHighlight() {
        if (mergeCandidate) mergeCandidate.classList.remove('merge-target');
        mergeCandidate = null;
      }

      bmLists.forEach((root) => {
        Sortable.create(root, {
          animation: 150,
          group: 'bm-shared',
          handle: '.drag-handle',
          ghostClass: 'sortable-ghost',
          chosenClass: 'sortable-chosen',
          dragClass: 'sortable-drag',
          onMove: (evt, originalEvent) => {
            const related = evt.related;
            const isPlainBookmarkInMainGrid = evt.to === mainGrid && related
              && related.classList.contains('draggable-item')
              && related !== evt.dragged
              && !(related.dataset.id || '').startsWith('group-');

            if (!isPlainBookmarkInMainGrid) { clearMergeHighlight(); return true; }

            const rect = related.getBoundingClientRect();
            const point = originalEvent.touches && originalEvent.touches[0] ? originalEvent.touches[0] : originalEvent;
            const y = point.clientY;
            const inMiddleBand = y > rect.top + rect.height * 0.25 && y < rect.top + rect.height * 0.75;

            if (inMiddleBand) {
              if (mergeCandidate !== related) { clearMergeHighlight(); mergeCandidate = related; mergeCandidate.classList.add('merge-target'); }
              return false;
            }
            clearMergeHighlight();
            return true;
          },
          onEnd: (evt) => {
            const draggedId = evt.item.dataset.id;

            if (mergeCandidate && mergeCandidate !== evt.item) {
              const targetId = mergeCandidate.dataset.id;
              clearMergeHighlight();
              persist('<%= baseUrl %>/dashboard-groups', { bookmarkIds: [targetId, draggedId] })
                .then(() => window.location.reload());
              return;
            }
            clearMergeHighlight();

            const fromGroupId = evt.from.dataset.groupId || null;
            const toGroupId = evt.to.dataset.groupId || null;

            if (fromGroupId === toGroupId) {
              if (toGroupId) {
                persist('<%= baseUrl %>/dashboard-groups/members/reorder', { ids: directItems(evt.to).map((el) => el.dataset.id) });
              } else {
                const items = directItems(evt.to);
                const bookmarkIds = items.filter((el) => !(el.dataset.id || '').startsWith('group-')).map((el) => el.dataset.id);
                const groupIds = items.filter((el) => (el.dataset.id || '').startsWith('group-')).map((el) => el.dataset.id.replace('group-', ''));
                persist('<%= baseUrl %>/bookmarks/reorder', { ids: bookmarkIds });
                if (groupIds.length) persist('<%= baseUrl %>/dashboard-groups/reorder', { ids: groupIds });
              }
              return;
            }

            if (toGroupId) {
              persist(`<%= baseUrl %>/dashboard-groups/${toGroupId}/bookmarks`, { bookmarkId: draggedId }).then(() => window.location.reload());
            } else {
              persist(`<%= baseUrl %>/dashboard-groups/bookmarks/${draggedId}/remove`, {}).then(() => window.location.reload());
            }
          }
        });
      });
    })();
  </script>

</body>
</html>
