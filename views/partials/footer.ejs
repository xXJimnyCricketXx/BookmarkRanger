  </main>

  <footer class="mt-auto footer-custom transition-colors duration-300">
    <div class="max-w-screen-xl mx-auto py-5 px-4">
      <div class="flex flex-col items-center justify-center space-y-2">
        <img src="<%= baseUrl %>/ressources/bookmarkranger-logo-mono-<%= locals.footerLogoVariant || 'dark' %>.png" alt="BookmarkRanger!" class="w-32 h-auto">
        <span class="inline-block card-theme text-primary-theme text-[10px] font-bold tracking-wide rounded-full px-3 py-0.5">
          v<%= appVersion %>
        </span>
      </div>
    </div>
  </footer>

  <script>
    document.addEventListener('click', async (e) => {
      const btn = e.target.closest('.copy-code-btn');
      if (!btn) return;
      const id = btn.dataset.copy;
      const source = document.getElementById('code-' + id);
      if (!source) return;
      try {
        await navigator.clipboard.writeText(source.value);
        const original = btn.textContent;
        btn.textContent = '<%= t("snippets.copied") %>';
        setTimeout(() => { btn.textContent = original; }, 1500);
      } catch (err) { /* clipboard unavailable */ }
    });
  </script>

  <script>
    // Native HTML5 drag-and-drop reordering for any ".dragroot[data-reorder-url]"
    // container of ".draggable-item[data-id]" children (dashboard pinned sections).
    function getDragAfterElement(container, y) {
      const items = [...container.querySelectorAll('.draggable-item:not(.dragging)')];
      return items.reduce((closest, child) => {
        const box = child.getBoundingClientRect();
        const offset = y - box.top - box.height / 2;
        if (offset < 0 && offset > closest.offset) return { offset, element: child };
        return closest;
      }, { offset: Number.NEGATIVE_INFINITY }).element;
    }

    document.querySelectorAll('.dragroot').forEach((root) => {
      let dragEl = null;

      root.querySelectorAll('.draggable-item').forEach((item) => {
        item.addEventListener('dragstart', () => {
          dragEl = item;
          item.classList.add('dragging', 'opacity-40');
        });
        item.addEventListener('dragend', () => {
          item.classList.remove('dragging', 'opacity-40');
        });
      });

      root.addEventListener('dragover', (e) => {
        e.preventDefault();
        if (!dragEl) return;
        const after = getDragAfterElement(root, e.clientY);
        if (after == null) root.appendChild(dragEl);
        else root.insertBefore(dragEl, after);
      });

      root.addEventListener('drop', async (e) => {
        e.preventDefault();
        const ids = [...root.querySelectorAll('.draggable-item')].map((el) => el.dataset.id);
        try {
          await fetch(root.dataset.reorderUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ids })
          });
        } catch (err) { /* ignore */ }
      });
    });
  </script>

</body>
</html>
