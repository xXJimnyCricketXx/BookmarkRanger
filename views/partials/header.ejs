<%
  const theme = locals.theme || (locals.resolveTheme && locals.allThemes ? locals.resolveTheme(locals.allThemes.bookmarkranger) : {
      bg: '#1a1a1d', card: '#232327', navbar: '#ff6f9c', footer: '#131316',
      text: '#f2f2f4', subtext: '#a3a3a8', highlight: '#ff6f9c', highlightText: '#1a1a1d',
      navText: '#1a1a2e', accentText: '#ff8fb3', footerText: '#f2f2f4', isDarkBg: true
  });
  const isDark = typeof locals.isDark !== 'undefined' ? locals.isDark : theme.isDarkBg;
  const logoVariant = locals.logoVariant || 'light';
  const siteName = (typeof settings !== 'undefined' && settings && settings.siteName) ? settings.siteName : 'BookmarkRanger';
%>
<!DOCTYPE html>
<html lang="<%= currentLng %>" class="<%= isDark ? 'dark' : '' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== 'undefined' ? title + ' — ' + siteName : siteName %></title>

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = { darkMode: 'class' };
  </script>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
  <link rel="icon" type="image/png" href="<%= baseUrl %>/ressources/bookmarkranger-icon.png">
  <link rel="apple-touch-icon" href="<%= baseUrl %>/ressources/bookmarkranger-icon.png">
  <script src="<%= baseUrl %>/vendor/sortable.min.js"></script>

  <style>
    :root {
        --bg-page: <%= theme.bg %>;
        --bg-card: <%= theme.card %>;
        --bg-nav: <%= theme.navbar %>;
        --text-main: <%= theme.text %>;
        --text-sub: <%= theme.subtext %>;
        --highlight: <%= theme.highlight %>;
        --highlight-text: <%= theme.highlightText %>;
        --nav-text: <%= theme.navText %>;
        --accent-text: <%= theme.accentText %>;
        --bg-footer: <%= theme.footer %>;
        --footer-text: <%= theme.footerText %>;
        --border-color: <%= theme.isDarkBg ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.1)' %>;
    }

    html, body { margin: 0; padding: 0; }
    body { background-color: var(--bg-page) !important; color: var(--text-main) !important; }

    .nav-custom { background-color: var(--bg-nav) !important; border-bottom: 1px solid var(--border-color); color: var(--nav-text) !important; }
    .footer-custom { background-color: var(--bg-footer) !important; border-top: 1px solid var(--border-color); color: var(--footer-text) !important; }
    .nav-link { color: var(--nav-text) !important; }
    .nav-link.active { font-weight: 800; border-bottom: 2px solid var(--nav-text); }

    .text-primary-theme { color: var(--accent-text) !important; }
    .bg-primary-theme { background-color: var(--highlight) !important; color: var(--highlight-text) !important; }
    .border-primary-theme { border-color: var(--highlight) !important; }
    .hover\:bg-primary-theme:hover { background-color: var(--highlight) !important; color: var(--highlight-text) !important; }

    .card-theme { background-color: var(--bg-card) !important; border: 1px solid var(--border-color); color: var(--text-main) !important; }
    .input-theme { background-color: var(--bg-card) !important; border: 1px solid var(--border-color); color: var(--text-main) !important; }
    .input-theme::placeholder { color: var(--text-sub) !important; opacity: 0.7; }

    /* The closed <select> inherits theme colors fine via .input-theme/bg-transparent, but the
       native dropdown popup list ignores that unless the <option> elements are styled too —
       otherwise it falls back to the browser's white default, unreadable in dark themes. */
    select option { background-color: var(--bg-card); color: var(--text-main); }

    .tab-link { color: var(--text-sub); border-bottom: 2px solid transparent; }
    .tab-link.active { color: var(--accent-text); border-bottom: 2px solid var(--highlight); }

    /* SortableJS drag placeholder: a dashed "drop here" box, like WordPress dashboard widgets. */
    .sortable-ghost { background: transparent !important; border: 2px dashed var(--highlight) !important; box-shadow: none !important; }
    .sortable-ghost > * { visibility: hidden; }
    .sortable-chosen { cursor: grabbing; }
    .sortable-drag { opacity: 0.9; }

    /* Hovering one pinned bookmark over another (not a box) mid-drag signals "merge these into a box". */
    .merge-target { outline: 2px dashed var(--highlight) !important; outline-offset: 2px; background-color: color-mix(in srgb, var(--highlight) 12%, transparent) !important; }

    /* Fixed sidebar width/spacing, shared by every page that has one (Settings, Snippets, …). */
    .layout-with-sidebar { display: flex; flex-direction: column; gap: 3.5rem; }
    @media (min-width: 768px) { .layout-with-sidebar { flex-direction: row; } }
    .sidebar { width: 100%; flex-shrink: 0; }
    @media (min-width: 768px) { .sidebar { width: 15rem; } }
  </style>
</head>

<body class="font-sans transition-colors duration-300 min-h-screen flex flex-col">

  <nav class="nav-custom transition-colors duration-300">
    <div class="w-full flex flex-wrap items-center justify-between px-6 py-4 gap-4">
      <a href="<%= baseUrl || '/' %>" class="flex items-center">
        <%# Mono variant, not the two-tone one: the "Ranger!" script is a fixed brand pink in the
            regular logo, which clashes on non-pink headers (e.g. Lime). Variant (light/dark text)
            is still derived from the navbar's actual color. %>
        <img src="<%= baseUrl %>/ressources/bookmarkranger-logo-mono-<%= logoVariant %>.png" alt="BookmarkRanger!" class="w-44 h-auto">
      </a>

      <ul class="flex items-center gap-6 order-3 md:order-2 w-full md:w-auto justify-center md:justify-start">
        <li><a href="<%= baseUrl %>/" class="nav-link font-semibold text-sm <%= locals.activeNav === 'home' ? 'active' : '' %>"><%= t('nav.home') %></a></li>
        <li><a href="<%= baseUrl %>/bookmarks" class="nav-link font-semibold text-sm <%= locals.activeNav === 'bookmarks' ? 'active' : '' %>"><%= t('nav.bookmarks') %></a></li>
        <li><a href="<%= baseUrl %>/snippets" class="nav-link font-semibold text-sm <%= locals.activeNav === 'snippets' ? 'active' : '' %>"><%= t('nav.snippets') %></a></li>
      </ul>

      <div class="flex items-center gap-3 order-2 md:order-3">
        <a href="<%= baseUrl %>/settings" class="w-9 h-9 rounded-full flex items-center justify-center hover:bg-black/10 dark:hover:bg-white/10 transition" title="<%= t('nav.settings') %>">
          <i class="fa-solid fa-gear nav-link"></i>
        </a>
        <form action="<%= baseUrl %>/logout" method="POST">
          <button type="submit" class="w-9 h-9 rounded-full flex items-center justify-center hover:bg-black/10 dark:hover:bg-white/10 transition" title="<%= t('nav.logout') %>">
            <i class="fa-solid fa-arrow-right-from-bracket nav-link"></i>
          </button>
        </form>
      </div>
    </div>
  </nav>

  <main class="p-6 flex-grow w-full max-w-[1440px] mx-auto">
