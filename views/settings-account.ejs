<%- include('partials/header') %>

<div class="flex flex-col md:flex-row gap-10">
  <%- include('partials/settings-nav', { active: 'account' }) %>

  <div class="flex-grow max-w-xl space-y-10">
    <div>
      <h2 class="text-xl font-black mb-4"><%= t('settings.nav_account') %></h2>

      <% if (error) { %><p class="text-red-500 text-sm mb-4"><%= t(error) %></p><% } %>
      <% if (success) { %><p class="text-green-500 text-sm mb-4"><%= t(success) %></p><% } %>

      <form action="<%= baseUrl %>/settings/account" method="POST" class="space-y-5">
        <div>
          <label class="block text-sm font-bold mb-2"><%= t('settings.account_username') %></label>
          <input type="text" name="username" value="<%= account.username %>" class="input-theme w-full px-4 py-3 rounded-xl text-sm">
        </div>

        <div>
          <label class="block text-sm font-bold mb-2"><%= t('settings.account_current_password') %></label>
          <input type="password" name="currentPassword" required class="input-theme w-full px-4 py-3 rounded-xl text-sm">
        </div>

        <div>
          <label class="block text-sm font-bold mb-2"><%= t('settings.account_new_password') %></label>
          <input type="password" name="newPassword" minlength="6" placeholder="••••••••" class="input-theme w-full px-4 py-3 rounded-xl text-sm">
        </div>

        <div>
          <label class="block text-sm font-bold mb-2"><%= t('settings.account_new_password_confirm') %></label>
          <input type="password" name="newPasswordConfirm" minlength="6" class="input-theme w-full px-4 py-3 rounded-xl text-sm">
        </div>

        <button type="submit" class="bg-primary-theme font-bold px-6 py-3 rounded-xl hover:brightness-110 transition"><%= t('settings.save_changes') %></button>
      </form>
    </div>

    <div class="border-t border-black/5 dark:border-white/10 pt-8">
      <h2 class="text-xl font-black mb-4"><%= t('settings.backups_title') %></h2>

      <form action="<%= baseUrl %>/settings/account/backup" method="POST" class="mb-5">
        <button type="submit" class="bg-primary-theme font-bold px-5 py-2.5 rounded-xl text-sm hover:brightness-110 transition"><%= t('settings.create_backup') %></button>
      </form>

      <% if (backups.length === 0) { %>
        <p class="opacity-50 text-sm"><%= t('settings.no_backups') %></p>
      <% } else { %>
        <ul class="space-y-2">
          <% backups.forEach(file => { %>
            <li class="card-theme rounded-xl px-4 py-2.5 flex items-center justify-between text-sm">
              <span class="truncate"><%= file %></span>
              <a href="<%= baseUrl %>/settings/account/backup/<%= file %>" class="text-primary-theme font-bold shrink-0 ml-3"><%= t('settings.download') %></a>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
