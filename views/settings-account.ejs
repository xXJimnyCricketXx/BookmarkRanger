<%- include('partials/header') %>

<div class="layout-with-sidebar">
  <%- include('partials/settings-nav', { active: 'account' }) %>

  <div class="flex-grow max-w-xl space-y-10">
    <div>
      <h2 class="text-xl font-black mb-4"><%= t('settings.nav_account') %></h2>

      <% if (error) { %><p class="text-red-500 text-sm mb-4"><%= t(error) %></p><% } %>
      <% if (success) { %><p class="text-green-500 text-sm mb-4"><%= t(success) %></p><% } %>

      <form action="<%= baseUrl %>/settings/account" method="POST" class="space-y-5">
        <div>
          <label class="block text-sm font-bold mb-2"><%= t('settings.account_username') %></label>
          <input type="text" name="username" value="<%= account.username %>" class="input-theme w-full px-4 py-3 rounded-xl text-sm">
        </div>

        <div>
          <label class="block text-sm font-bold mb-2"><%= t('settings.account_current_password') %></label>
          <input type="password" name="currentPassword" required class="input-theme w-full px-4 py-3 rounded-xl text-sm">
        </div>

        <div>
          <label class="block text-sm font-bold mb-2"><%= t('settings.account_new_password') %></label>
          <input type="password" name="newPassword" minlength="6" placeholder="••••••••" class="input-theme w-full px-4 py-3 rounded-xl text-sm">
        </div>

        <div>
          <label class="block text-sm font-bold mb-2"><%= t('settings.account_new_password_confirm') %></label>
          <input type="password" name="newPasswordConfirm" minlength="6" class="input-theme w-full px-4 py-3 rounded-xl text-sm">
        </div>

        <button type="submit" class="bg-primary-theme font-bold px-6 py-3 rounded-xl hover:brightness-110 transition"><%= t('settings.save_changes') %></button>
      </form>
    </div>

    <div class="border-t border-black/5 dark:border-white/10 pt-8">
      <h2 class="text-xl font-black mb-4"><%= t('settings.app_info_title') %></h2>

      <div class="card-theme rounded-xl p-5 space-y-3 text-sm">
        <div>
          <a href="<%= repoUrl %>" target="_blank" rel="noopener" class="font-bold text-primary-theme hover:underline">BookmarkRanger</a>
          <span class="opacity-60">v<%= appVersion %></span>
        </div>
        <div>
          <a href="<%= repoUrl %>/blob/main/CHANGELOG.md" target="_blank" rel="noopener" class="text-primary-theme hover:underline"><%= t('settings.see_changelog') %></a>
        </div>
        <div class="pt-2">
          <button type="button" id="check-update-btn" class="input-theme px-4 py-2 rounded-xl text-sm font-bold hover:bg-black/5 dark:hover:bg-white/10 transition"><%= t('settings.check_for_updates') %></button>
          <p id="check-update-result" class="text-xs opacity-70 mt-2"></p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.getElementById('check-update-btn').addEventListener('click', async (e) => {
    const btn = e.target;
    const result = document.getElementById('check-update-result');
    btn.disabled = true;
    result.textContent = '<%= t("settings.checking_for_updates") %>';
    try {
      const res = await fetch('<%= baseUrl %>/settings/account/check-update');
      const data = await res.json();
      if (!data.checked) {
        result.textContent = '<%= t("settings.update_check_failed") %>';
      } else if (data.updateAvailable) {
        result.textContent = '<%= t("settings.update_available") %> v' + data.latest;
      } else {
        result.textContent = '<%= t("settings.up_to_date") %>';
      }
    } catch (err) {
      result.textContent = '<%= t("settings.update_check_failed") %>';
    } finally {
      btn.disabled = false;
    }
  });
</script>

<%- include('partials/footer') %>
