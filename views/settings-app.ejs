<%- include('partials/header') %>

<div class="layout-with-sidebar">
  <%- include('partials/settings-nav', { active: 'app' }) %>

  <div class="flex-grow max-w-xl">
    <h2 class="text-xl font-black mb-4"><%= t('settings.app_version_title') %></h2>

    <div class="card-theme rounded-xl p-5 space-y-3 text-sm">
      <div>
        <a href="<%= repoUrl %>" target="_blank" rel="noopener" class="font-bold text-primary-theme hover:underline">BookmarkRanger!</a>
        <span class="opacity-60">v<%= appVersion %></span>
      </div>
      <div>
        <button type="button" id="changelog-btn" class="text-primary-theme hover:underline"><%= t('settings.changelog_button') %></button>
      </div>
    </div>
  </div>
</div>

<div id="changelog-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div id="changelog-backdrop" class="absolute inset-0 bg-black/60"></div>
  <div class="card-theme relative rounded-3xl shadow-xl p-6 md:p-8 w-full max-w-3xl max-h-[85vh] overflow-y-auto">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-sm font-black opacity-60 uppercase tracking-wide"><%= t('settings.changelog_modal_title') %></h2>
      <button type="button" id="changelog-close" class="w-8 h-8 rounded-full flex items-center justify-center hover:bg-black/10 dark:hover:bg-white/10 transition">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
    <div class="space-y-8">
      <% changelog.forEach((entry, i) => { %>
        <div class="<%= i > 0 ? 'pt-8 border-t border-black/10 dark:border-white/10' : '' %>">
          <div class="flex items-center gap-3 mb-4">
            <span class="bg-primary-theme font-black text-xs px-3 py-1 rounded-full">v<%= entry.version %></span>
            <span class="text-xs opacity-50"><%= entry.date %></span>
            <% if (i === 0) { %>
              <span class="text-xs font-bold text-primary-theme"><%= t('settings.changelog_current') %></span>
            <% } %>
          </div>
          <ul class="space-y-2.5 text-sm opacity-80 leading-relaxed">
            <% entry.changes.forEach(change => { %>
              <li class="flex gap-3">
                <i class="fa-solid fa-circle text-[5px] mt-[7px] opacity-50 shrink-0"></i>
                <span><%= change %></span>
              </li>
            <% }) %>
          </ul>
        </div>
      <% }) %>
    </div>
  </div>
</div>

<script>
  const changelogModal = document.getElementById('changelog-modal');
  document.getElementById('changelog-btn').addEventListener('click', () => changelogModal.classList.remove('hidden'));
  document.getElementById('changelog-close').addEventListener('click', () => changelogModal.classList.add('hidden'));
  document.getElementById('changelog-backdrop').addEventListener('click', () => changelogModal.classList.add('hidden'));
</script>

<%- include('partials/footer') %>
