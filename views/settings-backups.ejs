<%- include('partials/header') %>

<div class="layout-with-sidebar">
  <%- include('partials/settings-nav', { active: 'backups' }) %>

  <div class="flex-grow max-w-xl">
    <h2 class="text-xl font-black mb-4"><%= t('settings.backups_title') %></h2>

    <form action="<%= baseUrl %>/settings/backups" method="POST" class="mb-5">
      <button type="submit" class="bg-primary-theme font-bold px-5 py-2.5 rounded-xl text-sm hover:brightness-110 transition"><%= t('settings.create_backup') %></button>
    </form>

    <% if (backups.length === 0) { %>
      <p class="opacity-50 text-sm"><%= t('settings.no_backups') %></p>
    <% } else { %>
      <ul class="space-y-2">
        <% backups.forEach(file => { %>
          <li class="card-theme rounded-xl px-4 py-2.5 flex items-center justify-between text-sm">
            <span class="truncate"><%= file %></span>
            <a href="<%= baseUrl %>/settings/backups/<%= file %>" class="text-primary-theme font-bold shrink-0 ml-3"><%= t('settings.download') %></a>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
