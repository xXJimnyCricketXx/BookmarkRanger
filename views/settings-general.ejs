<%- include('partials/header') %>

<div class="layout-with-sidebar">
  <%- include('partials/settings-nav', { active: 'general' }) %>

  <div class="flex-grow max-w-xl">
    <form action="<%= baseUrl %>/settings/general" method="POST" class="space-y-8">
      <div>
        <h2 class="text-lg font-black mb-4 pb-2 border-b border-black/5 dark:border-white/10"><%= t('settings.general_section') %></h2>
        <div class="space-y-6">
          <div>
            <label class="block text-sm font-bold mb-2"><%= t('settings.general_sorting_type') %></label>
            <select name="sortingType" class="input-theme w-full px-4 py-3 rounded-xl text-sm">
              <option value="createdAt" <%= settings.sortingType === 'createdAt' ? 'selected' : '' %>><%= t('settings.sort_created') %></option>
              <option value="name" <%= settings.sortingType === 'name' ? 'selected' : '' %>><%= t('settings.sort_name') %></option>
              <option value="custom" <%= settings.sortingType === 'custom' ? 'selected' : '' %>><%= t('settings.sort_custom') %></option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-bold mb-2"><%= t('settings.fallback_search_provider') %></label>
            <div class="flex gap-2">
              <select name="fallbackSearchProviderId" class="input-theme w-full px-4 py-3 rounded-xl text-sm">
                <option value=""><%= t('settings.no_fallback_search') %></option>
                <% searchProviders.forEach(provider => { %>
                  <option value="<%= provider.id %>" <%= settings.fallbackSearchProviderId === provider.id ? 'selected' : '' %>><%= provider.name %></option>
                <% }) %>
              </select>
              <a href="<%= baseUrl %>/settings/search-providers/add" title="<%= t('settings.add_search_provider') %>"
                class="input-theme shrink-0 w-12 flex items-center justify-center rounded-xl hover:bg-black/5 dark:hover:bg-white/10 transition">
                <i class="fa-solid fa-plus"></i>
              </a>
            </div>
            <p class="text-xs opacity-50 mt-1"><%= t('settings.fallback_search_hint') %></p>
          </div>
        </div>
      </div>

      <div>
        <h2 class="text-lg font-black mb-4 pb-2 border-b border-black/5 dark:border-white/10"><%= t('settings.bookmarks_section') %></h2>
        <div class="space-y-6">
          <div>
            <label class="block text-sm font-bold mb-2"><%= t('settings.general_pin_categories') %></label>
            <select name="pinCategoriesByDefault" class="input-theme w-full px-4 py-3 rounded-xl text-sm">
              <option value="true" <%= settings.pinCategoriesByDefault ? 'selected' : '' %>><%= t('settings.true') %></option>
              <option value="false" <%= !settings.pinCategoriesByDefault ? 'selected' : '' %>><%= t('settings.false') %></option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-bold mb-2"><%= t('settings.general_pin_bookmarks') %></label>
            <select name="pinBookmarksByDefault" class="input-theme w-full px-4 py-3 rounded-xl text-sm">
              <option value="true" <%= settings.pinBookmarksByDefault ? 'selected' : '' %>><%= t('settings.true') %></option>
              <option value="false" <%= !settings.pinBookmarksByDefault ? 'selected' : '' %>><%= t('settings.false') %></option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-bold mb-2"><%= t('settings.general_open_new_tab') %></label>
            <select name="openLinksInNewTab" class="input-theme w-full px-4 py-3 rounded-xl text-sm">
              <option value="true" <%= settings.openLinksInNewTab ? 'selected' : '' %>><%= t('settings.true') %></option>
              <option value="false" <%= !settings.openLinksInNewTab ? 'selected' : '' %>><%= t('settings.false') %></option>
            </select>
          </div>
        </div>
      </div>

      <div>
        <h2 class="text-lg font-black mb-4 pb-2 border-b border-black/5 dark:border-white/10"><%= t('settings.snippets_section') %></h2>
        <div>
          <label class="block text-sm font-bold mb-2"><%= t('settings.general_pin_snippets') %></label>
          <select name="pinSnippetsByDefault" class="input-theme w-full px-4 py-3 rounded-xl text-sm">
            <option value="true" <%= settings.pinSnippetsByDefault ? 'selected' : '' %>><%= t('settings.true') %></option>
            <option value="false" <%= !settings.pinSnippetsByDefault ? 'selected' : '' %>><%= t('settings.false') %></option>
          </select>
        </div>
      </div>

      <button type="submit" class="bg-primary-theme font-bold px-6 py-3 rounded-xl hover:brightness-110 transition"><%= t('settings.save_changes') %></button>
    </form>

    <% if (searchProviders.length > 0) { %>
      <div class="mt-10 pt-8 border-t border-black/5 dark:border-white/10">
        <h2 class="text-lg font-black mb-4"><%= t('settings.manage_search_providers') %></h2>
        <ul class="space-y-2">
          <% searchProviders.forEach(provider => { %>
            <li class="card-theme rounded-xl px-4 py-2.5 flex items-center justify-between text-sm gap-3">
              <span class="truncate"><%= provider.name %> <span class="opacity-40 text-xs"><%= provider.queryTemplate %></span></span>
              <form action="<%= baseUrl %>/settings/search-providers/<%= provider.id %>/delete" method="POST" onsubmit="return confirm('<%= provider.name %>?')">
                <button type="submit" title="<%= t('bookmarks.delete') %>" class="shrink-0"><i class="fa-solid fa-trash text-xs opacity-40 hover:opacity-80"></i></button>
              </form>
            </li>
          <% }) %>
        </ul>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
