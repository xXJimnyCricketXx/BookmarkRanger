<%- include('partials/header') %>

<div class="max-w-xl mx-auto">
  <a href="<%= baseUrl %>/settings/general" class="text-sm opacity-60 hover:opacity-100 inline-block mb-4">&larr; <%= t('settings.nav_general') %></a>

  <h1 class="text-2xl font-black mb-6"><%= t('settings.add_search_provider') %></h1>

  <form action="<%= baseUrl %>/settings/search-providers" method="POST" class="card-theme rounded-3xl shadow-xl p-6 space-y-5">
    <div>
      <label class="block text-sm font-bold mb-2"><%= t('settings.search_provider_name') %></label>
      <input type="text" name="name" required placeholder="Google" class="input-theme w-full px-4 py-3 rounded-xl text-sm">
    </div>

    <div>
      <label class="block text-sm font-bold mb-2"><%= t('settings.search_provider_query_template') %></label>
      <input type="text" name="queryTemplate" required placeholder="https://www.google.com/search?q=" class="input-theme w-full px-4 py-3 rounded-xl text-sm">
      <p class="text-xs opacity-50 mt-1"><%= t('settings.search_provider_hint') %></p>
    </div>

    <button type="submit" class="w-full bg-primary-theme font-black py-3 rounded-xl hover:brightness-110 transition-all">
      <%= t('settings.add_provider') %>
    </button>
  </form>
</div>

<%- include('partials/footer') %>
