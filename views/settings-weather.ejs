<%- include('partials/header') %>

<div class="layout-with-sidebar">
  <%- include('partials/settings-nav', { active: 'weather' }) %>

  <div class="flex-grow max-w-xl">
    <form action="<%= baseUrl %>/settings/weather" method="POST" class="space-y-8">
      <div>
        <h2 class="text-lg font-black mb-4 pb-2 border-b border-black/5 dark:border-white/10"><%= t('settings.weather_location_section') %></h2>
        <div class="space-y-6">
          <div>
            <label class="block text-sm font-bold mb-2"><%= t('settings.weather_latitude') %></label>
            <input type="text" name="weatherLat" value="<%= settings.weatherLat ?? '' %>" placeholder="52.52" class="input-theme w-full px-4 py-3 rounded-xl text-sm">
          </div>
          <div>
            <label class="block text-sm font-bold mb-2"><%= t('settings.weather_longitude') %></label>
            <input type="text" name="weatherLon" value="<%= settings.weatherLon ?? '' %>" placeholder="13.40" class="input-theme w-full px-4 py-3 rounded-xl text-sm">
          </div>
        </div>
      </div>

      <div>
        <h2 class="text-lg font-black mb-4 pb-2 border-b border-black/5 dark:border-white/10"><%= t('settings.weather_other_section') %></h2>
        <div class="space-y-6">
          <div>
            <label class="block text-sm font-bold mb-2"><%= t('settings.weather_unit') %></label>
            <div class="relative group">
              <select name="weatherUnit" class="select-theme input-theme w-full px-4 py-3 rounded-xl text-sm cursor-pointer">
                <option value="celsius" <%= settings.weatherUnit === 'celsius' ? 'selected' : '' %>><%= t('settings.weather_unit_celsius') %></option>
                <option value="fahrenheit" <%= settings.weatherUnit === 'fahrenheit' ? 'selected' : '' %>><%= t('settings.weather_unit_fahrenheit') %></option>
              </select>
              <i class="fa-solid fa-chevron-down text-[10px] opacity-20 group-hover:opacity-60 transition-all absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none"></i>
            </div>
          </div>
          <div>
            <label class="block text-sm font-bold mb-2"><%= t('settings.weather_extra') %></label>
            <div class="relative group">
              <select name="weatherExtra" class="select-theme input-theme w-full px-4 py-3 rounded-xl text-sm cursor-pointer">
                <option value="humidity" <%= settings.weatherExtra === 'humidity' ? 'selected' : '' %>><%= t('settings.weather_extra_humidity') %></option>
                <option value="cloud_coverage" <%= settings.weatherExtra === 'cloud_coverage' ? 'selected' : '' %>><%= t('settings.weather_extra_cloud_coverage') %></option>
              </select>
              <i class="fa-solid fa-chevron-down text-[10px] opacity-20 group-hover:opacity-60 transition-all absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none"></i>
            </div>
          </div>
        </div>
      </div>

      <button type="submit" class="bg-primary-theme font-bold px-6 py-3 rounded-xl hover:brightness-110 transition"><%= t('settings.save_changes') %></button>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
