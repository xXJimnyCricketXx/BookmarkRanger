<%
  const THEMES = (typeof locals.allThemes !== 'undefined') ? locals.allThemes : {};
  const activeDarkTheme = THEMES['bookmarkranger'].dark;
%>
<!DOCTYPE html>
<html lang="<%= currentLng %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title><%= t('setup.title') %></title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
  <link rel="icon" type="image/png" href="<%= baseUrl %>/ressources/bookmarkranger-icon.png">

  <style>
    body { background: <%= activeDarkTheme.bg %>; color: <%= activeDarkTheme.text %>; }
    .form-bg { background: <%= activeDarkTheme.card %>; border: 1px solid rgba(255,255,255,0.1); }
    input { background: rgba(255,255,255,0.05); color: <%= activeDarkTheme.text %>; border: 1px solid rgba(255,255,255,0.1); }
    input::placeholder { color: <%= activeDarkTheme.subtext %>; }
    input:focus { outline: none; box-shadow: 0 0 0 2px <%= activeDarkTheme.highlight %>; border-color: <%= activeDarkTheme.highlight %>; }
    .btn-setup { background: <%= activeDarkTheme.highlight %>; color: <%= activeDarkTheme.highlightText || '#fff' %>; }
    .btn-setup:hover { filter: brightness(1.1); }
    .error { color: #f87171; }
  </style>
</head>
<body class="flex flex-col min-h-screen">
  <div class="flex-grow flex items-center justify-center p-4">
    <section class="w-full max-w-md">
      <div class="text-center mb-8">
        <img src="<%= baseUrl %>/ressources/bookmarkranger-logo-dark.png" alt="BookmarkRanger!" class="mx-auto w-64 h-auto mb-4">
        <p class="opacity-70 text-sm"><%= t('setup.subtitle') %></p>
      </div>

      <div class="form-bg rounded-2xl shadow-xl p-8">
        <h1 class="text-xl font-black mb-6 text-center"><%= t('setup.title') %></h1>

        <% if (error) { %>
          <p class="error text-sm text-center mb-4"><%= t(error) %></p>
        <% } %>

        <form action="<%= baseUrl %>/setup" method="POST" class="space-y-5">
          <div>
            <label class="block text-sm font-medium mb-2 opacity-80"><%= t('setup.username_label') %></label>
            <input type="text" name="username" required autofocus class="w-full px-4 py-3 rounded-lg transition-all">
          </div>

          <div>
            <label class="block text-sm font-medium mb-2 opacity-80"><%= t('setup.password_label') %></label>
            <input type="password" name="password" required minlength="6" class="w-full px-4 py-3 rounded-lg transition-all">
          </div>

          <div>
            <label class="block text-sm font-medium mb-2 opacity-80"><%= t('setup.password_confirm_label') %></label>
            <input type="password" name="passwordConfirm" required minlength="6" class="w-full px-4 py-3 rounded-lg transition-all">
          </div>

          <button type="submit" class="btn-setup w-full font-bold py-3 px-6 rounded-lg transition-all">
            <%= t('setup.submit_btn') %>
          </button>
        </form>
      </div>
    </section>
  </div>
</body>
</html>
