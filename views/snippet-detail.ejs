<%
  locals.activeNav = 'snippets';
  const langColors = {
    python: 'bg-amber-500', javascript: 'bg-yellow-400 text-black', typescript: 'bg-blue-600',
    sql: 'bg-teal-500', java: 'bg-red-500', html: 'bg-orange-500', css: 'bg-sky-500',
    php: 'bg-indigo-500', bash: 'bg-slate-500', shell: 'bg-slate-500', go: 'bg-cyan-600',
    rust: 'bg-orange-700', csharp: 'bg-purple-600', c: 'bg-gray-500', cpp: 'bg-gray-600'
  };
  const langClass = langColors[snippet.language] || 'bg-gray-500';
%>
<%- include('partials/header') %>

<a href="<%= baseUrl %>/snippets" class="text-sm opacity-60 hover:opacity-100 inline-block mb-4">&larr; <%= t('snippetDetail.back') %></a>

<div class="flex flex-col lg:flex-row gap-6 items-start">
  <div class="flex-grow w-full max-w-[856px]">
    <pre class="text-sm rounded-xl overflow-hidden" style="white-space: pre-wrap; word-break: break-word;"><code class="hljs language-<%= snippet.language %>"><%- highlightedCode %></code></pre>
    <textarea class="hidden" id="code-<%= snippet.id %>"><%= snippet.code %></textarea>

    <% if (snippet.documentation) { %>
      <div class="mt-6">
        <h2 class="font-bold text-sm mb-2 opacity-80"><%= t('snippetDetail.documentation_title') %></h2>
        <p class="text-sm opacity-80 whitespace-pre-wrap"><%= snippet.documentation %></p>
      </div>
    <% } %>
  </div>

  <div class="card-theme rounded-3xl shadow-xl p-6 w-full lg:w-[416px] shrink-0">
    <div class="flex items-start justify-between gap-3 mb-1">
      <h1 class="text-xl font-black"><%= snippet.title %></h1>
      <form action="<%= baseUrl %>/snippets/<%= snippet.id %>/pin" method="POST">
        <button type="submit" title="<%= snippet.isPinned ? t('bookmarks.unpin') : t('bookmarks.pin') %>" class="shrink-0">
          <i class="fa-solid fa-thumbtack <%= snippet.isPinned ? 'text-primary-theme' : 'opacity-30 hover:opacity-70' %> transition"></i>
        </button>
      </form>
    </div>

    <% if (snippet.shortDescription) { %>
      <p class="text-sm opacity-70 mb-4"><%= snippet.shortDescription %></p>
    <% } %>

    <hr class="border-black/10 dark:border-white/10 mb-4">

    <div class="space-y-2 text-sm mb-4">
      <div class="flex items-center justify-between">
        <span class="opacity-60"><%= t('snippetDetail.language_label') %></span>
        <span class="font-bold"><%= snippet.language %></span>
      </div>
      <div class="flex items-center justify-between">
        <span class="opacity-60"><%= t('snippetDetail.created_label') %></span>
        <span><%= timeAgo(snippet.createdAt) %></span>
      </div>
      <div class="flex items-center justify-between">
        <span class="opacity-60"><%= t('snippetDetail.last_updated_label') %></span>
        <span><%= timeAgo(snippet.updatedAt) %></span>
      </div>
    </div>

    <% if (snippet.tags.length) { %>
      <hr class="border-black/10 dark:border-white/10 mb-4">
      <div class="flex flex-wrap gap-2 mb-4">
        <% snippet.tags.forEach(tag => { %>
          <span class="text-xs bg-black/5 dark:bg-white/10 px-2 py-1 rounded-full"><%= tag.name %></span>
        <% }) %>
      </div>
    <% } %>

    <hr class="border-black/10 dark:border-white/10 mb-4">

    <div class="space-y-2">
      <form action="<%= baseUrl %>/snippets/<%= snippet.id %>/delete" method="POST" onsubmit="return confirm('<%= t('common.confirm_delete', { name: snippet.title }) %>')">
        <button type="submit" class="w-full text-sm font-bold px-4 py-2.5 rounded-xl bg-red-500/10 text-red-500 hover:bg-red-500/20 transition"><%= t('snippetDetail.delete') %></button>
      </form>
      <a href="<%= baseUrl %>/snippets/<%= snippet.id %>/edit" class="block text-center text-sm font-bold px-4 py-2.5 rounded-xl bg-black/5 dark:bg-white/10 hover:bg-black/10 dark:hover:bg-white/20 transition"><%= t('snippetDetail.edit') %></a>
      <button type="button" class="copy-raw-url-btn w-full text-sm font-bold px-4 py-2.5 rounded-xl bg-black/5 dark:bg-white/10 hover:bg-black/10 dark:hover:bg-white/20 transition" data-url="<%= baseUrl %>/snippets/<%= snippet.id %>/raw"><%= t('snippetDetail.copy_raw_url') %></button>
      <button type="button" data-copy="<%= snippet.id %>" class="copy-code-btn w-full text-sm font-bold px-4 py-2.5 rounded-xl bg-primary-theme hover:brightness-110 transition"><%= t('snippets.copy_code') %></button>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
