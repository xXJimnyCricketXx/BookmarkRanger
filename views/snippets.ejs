<% locals.activeNav = 'snippets'; %>
<%- include('partials/header') %>

<div class="flex items-center justify-end gap-3 mb-6">
  <div class="relative">
    <button type="button" onclick="toggleSortMenu(event)" id="sortSelectorBtn"
      class="input-theme flex items-center gap-2 px-3 py-2.5 rounded-xl text-sm group">
      <i class="fa-solid fa-arrow-down-short-wide opacity-50 group-hover:opacity-100 transition-opacity"></i>
      <span class="opacity-60 group-hover:opacity-100 transition-opacity"><%= t('snippets.sort_label') %></span>
    </button>
    <div id="sort-menu"
      class="hidden absolute right-0 left-auto top-full z-50 mt-2 w-48 card-theme rounded-xl p-2 shadow-2xl border border-black/5 dark:border-white/10">
      <% const sortOptions = [
        { key: 'created', label: t('snippets.sort_created'), descFirst: true },
        { key: 'updated', label: t('snippets.sort_updated'), descFirst: true },
        { key: 'name', label: t('snippets.sort_name'), descFirst: false }
      ]; %>
      <% sortOptions.forEach(opt => {
        const isActive = currentSort.startsWith(opt.key);
        const currentDir = isActive ? (currentSort.endsWith('_asc') ? 'asc' : 'desc') : (opt.descFirst ? 'desc' : 'asc');
      %>
        <button type="button" onclick="handleSort('<%= opt.key %>', '<%= currentDir %>', <%= opt.descFirst %>)"
          class="w-full flex items-center justify-between gap-2 p-2.5 text-sm rounded-lg transition-all cursor-pointer <%= isActive ? 'bg-primary-theme/10 text-primary-theme font-semibold' : 'hover:bg-black/5 dark:hover:bg-white/5 opacity-70 hover:opacity-100' %>">
          <span><%= opt.label %></span>
          <% if (isActive) { %><i class="fa-solid fa-arrow-<%= currentDir === 'asc' ? 'up' : 'down' %> text-[11px]"></i><% } %>
        </button>
      <% }) %>
    </div>
  </div>
  <script>
    function toggleSortMenu(e) {
      e.stopPropagation();
      document.getElementById('sort-menu').classList.toggle('hidden');
    }
    document.addEventListener('click', (e) => {
      const menu = document.getElementById('sort-menu');
      if (!menu.classList.contains('hidden') && !menu.contains(e.target) && e.target.closest('#sortSelectorBtn') === null) {
        menu.classList.add('hidden');
      }
    });
    function handleSort(key, currentDir, descFirst) {
      const isAlreadyActive = '<%= currentSort %>'.startsWith(key);
      const newSort = key + '_' + (isAlreadyActive ? (currentDir === 'asc' ? 'desc' : 'asc') : (descFirst ? 'desc' : 'asc'));
      const url = new URL(window.location.href);
      url.searchParams.set('sort', newSort);
      window.location.href = url.toString();
    }
  </script>
  <a href="<%= baseUrl %>/snippets/add" class="bg-primary-theme font-bold px-4 py-2.5 rounded-xl text-sm hover:brightness-110 transition whitespace-nowrap">
    <i class="fa-solid fa-plus mr-1"></i> <%= t('snippets.add_new') %>
  </a>
</div>

<div class="layout-with-sidebar">
  <aside class="sidebar">
    <div class="card-theme rounded-3xl shadow-lg p-5">
      <div class="mb-3">
        <h2 class="font-black text-lg"><%= t('snippets.all_snippets') %></h2>
        <div class="flex items-center justify-between text-sm opacity-60 mt-1">
          <span><%= t('snippets.total') %></span>
          <span><%= total %></span>
        </div>
      </div>
      <hr class="border-black/10 dark:border-white/10 mb-4">

      <h3 class="font-black text-lg mb-3"><%= t('snippets.filter_by_tags') %></h3>
      <form action="<%= baseUrl %>/snippets" method="GET" class="space-y-1 mb-4">
        <% tags.forEach(([name, count]) => {
          const checked = activeTags.includes(name);
          const nextTags = checked ? activeTags.filter(t => t !== name) : [...activeTags, name];
          const params = new URLSearchParams();
          if (nextTags.length) params.set('tags', nextTags.join(','));
          if (currentSort !== 'created_desc') params.set('sort', currentSort);
          const qs = params.toString();
        %>
          <a href="<%= baseUrl %>/snippets<%= qs ? '?' + qs : '' %>"
            class="flex items-center justify-between text-sm py-1 px-2 rounded-lg transition <%= checked ? 'bg-primary-theme' : 'hover:bg-black/5 dark:hover:bg-white/10 opacity-80' %>">
            <span><%= name %></span>
            <span class="opacity-60"><%= count %></span>
          </a>
        <% }) %>
      </form>

      <a href="<%= baseUrl %>/snippets<%= currentSort !== 'created_desc' ? '?sort=' + currentSort : '' %>" class="input-theme block text-center text-sm font-bold px-3 py-2 rounded-xl"><%= t('snippets.clear_filters') %></a>
    </div>
  </aside>

  <div class="flex-grow">
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5">
      <% snippets.forEach(snippet => { %>
        <%- include('partials/snippet-card', { snippet }) %>
      <% }) %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
